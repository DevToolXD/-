rules_version = '2';

// =============================================================
//  Firestore 보안 규칙 - 마니또 웹앱 (학급코드 멀티클래스 구조)
// =============================================================
//  ⚠️ 반드시 읽어주세요 (이 스택의 보안 한계)
//  이 앱은 Firebase Authentication을 쓰지 않는 정적 사이트라서, 보안
//  규칙이 "누가 요청했는지"(request.auth)를 알 수 없습니다. 그래서
//  "본인만 자기 계정 수정", "선생님만 배정" 같은 사용자별 권한은
//  규칙 단에서 강제할 수 없고, 앱 로직(비밀번호/관리자코드 확인)에
//  의존합니다. 아래 규칙이 실제로 강제하는 것은:
//   - 학급코드가 유효한 값(0601~0609, 1889)인 경로만 허용
//   - 컬렉션 열거(list) 차단 (secrets 등) → 무작위 수집 방지
//   - 문서 필드 형태(허용된 키 목록·길이) 검증
//  더 강한 보장이 필요하면 Firebase Auth + Cloud Functions로 확장하세요.
// =============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function nonEmptyStr(v, max) {
      return v is string && v.size() > 0 && v.size() <= max;
    }
    function nullableStr(v, max) {
      return v == null || (v is string && v.size() <= max);
    }
    function validClassCode(code) {
      return code.matches('^(060[1-9]|1889)$');
    }
    // 줄바꿈/제어문자가 섞인 값 차단 (로그 위조·표시 깨짐 방지)
    function cleanStr(v, max) {
      return v is string && v.size() > 0 && v.size() <= max
             && !v.matches('.*[\\x00-\\x08\\x0b\\x0c\\x0e-\\x1f\\x7f].*');
    }
    // 클라이언트가 과거/미래 시각을 위조하지 못하도록 서버 시각만 허용
    function serverTime(v) {
      return v == request.time;
    }
    // 문서가 지나치게 커지는 것을 막음
    function smallDoc() {
      return request.resource.data.keys().size() <= 10;
    }

    match /classes/{code} {
      allow get: if validClassCode(code);
      allow list: if false;
      // adminHash/adminSalt 는 해시값이라 조회돼도 원문이 노출되지 않음
      allow create, update: if validClassCode(code)
        && request.resource.data.keys().hasOnly(['adminSalt','adminHash','createdAt'])
        && nonEmptyStr(request.resource.data.adminHash, 200)
        && nonEmptyStr(request.resource.data.adminSalt, 200);
      allow delete: if false;

      // ---- 학생 명단: 이름만 저장. 선생님이 삭제도 할 수 있음 ----
      match /students/{id} {
        allow get, list: if validClassCode(code);
        allow create: if validClassCode(code) && cleanStr(request.resource.data.name, 40);
        allow update: if false;
        allow delete: if validClassCode(code);
      }

      // ---- 시크릿: 비밀번호 해시 + 소원 + 배정 정보 ----
      match /secrets/{id} {
        allow get: if validClassCode(code);
        allow list: if false;
        allow create: if validClassCode(code) && request.resource.data.keys().hasOnly(
          ['hasPassword','wish','wishSetAt','wishRewriteNote','caringForId','caringForName']);
        allow update: if validClassCode(code)
          && request.resource.data.keys().hasOnly(
               ['hasPassword','wish','wishSetAt','wishRewriteNote','caringForId','caringForName','salt','pwHash'])
          && nullableStr(request.resource.data.get('wish', null), 300)
          && nullableStr(request.resource.data.get('wishRewriteNote', null), 300)
          && nullableStr(request.resource.data.get('caringForId', null), 200)
          && nullableStr(request.resource.data.get('caringForName', null), 40);
        allow delete: if validClassCode(code);
      }

      // ---- 신고함: 검열에 걸린 투표 항목 시도가 담임선생님께 쌓인다 ----
      //  선생님 화면에서만 목록을 보여주지만, Auth 없는 이 스택에서는
      //  규칙만으로 "선생님만 읽기"를 강제할 수 없다(광고 문의와 동일한 한계).
      match /reports/{id} {
        allow get: if false;
        allow list: if validClassCode(code);
        allow create: if validClassCode(code) && smallDoc()
          && request.resource.data.keys().hasOnly(['name','roleTag','text','reason','status','createdAt'])
          && cleanStr(request.resource.data.name, 40)
          && nullableStr(request.resource.data.get('roleTag', ''), 60)
          && cleanStr(request.resource.data.text, 40)
          && cleanStr(request.resource.data.reason, 60)
          && request.resource.data.status == 'pending'
          && serverTime(request.resource.data.createdAt);
        // 선생님의 처리 결과만 바꿀 수 있고, 신고 내용 자체는 고칠 수 없다.
        allow update: if validClassCode(code)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && request.resource.data.status in ['approved', 'rejected'];
        // 처리한 신고는 지울 수 있어야 한다. delete 를 막아두면 신고함이 영원히
        // 쌓이기만 해서 나중엔 쓸 수 없게 된다(다른 컬렉션과 같은 신뢰 모델).
        allow delete: if validClassCode(code);
      }

      // ---- meta: 관리자 코드 검증 이력이 필요없는 배정 상태만 ----
      match /meta/{docId} {
        allow get: if validClassCode(code) && docId == 'state';
        allow list: if false;
        allow write: if validClassCode(code) && docId == 'state'
          && request.resource.data.keys().hasOnly(['assignedAt','studentCount','teacherIncluded']);
      }
    }

    // ---- 주간 투표 항목 (사용자가 직접 올린다) ----
    //  검열은 클라이언트에서 하고 걸린 건 reports 로 보낸다. 규칙 단에서
    //  뜻까지 판단할 수는 없으므로 여기서는 형태(길이·필드·+1 증가)만 강제한다.
    match /voteItems/{id} {
      allow get, list: if true;
      allow create: if smallDoc()
        && request.resource.data.keys().hasOnly(
             ['label','count','weekKey','addedBy','addedByRole','createdAt'])
        && cleanStr(request.resource.data.label, 40)
        && request.resource.data.label.size() >= 2
        && request.resource.data.count == 0
        && request.resource.data.weekKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && cleanStr(request.resource.data.addedBy, 40)
        && nullableStr(request.resource.data.get('addedByRole', ''), 60)
        && serverTime(request.resource.data.createdAt);
      // 투표는 정확히 +1 씩만. 다른 필드는 손댈 수 없다.
      allow update: if request.resource.data.keys().hasOnly(
             ['label','count','weekKey','addedBy','addedByRole','createdAt'])
        && request.resource.data.count == resource.data.count + 1
        && request.resource.data.label == resource.data.label
        && request.resource.data.weekKey == resource.data.weekKey
        && request.resource.data.addedBy == resource.data.addedBy;
      // 삭제 버튼은 전체 관리자 화면에만 있음 (다른 컬렉션과 같은 신뢰 모델)
      allow delete: if true;
    }

    // ---- 주간 채택 결과: 문서 ID가 그 주 월요일 날짜라 한 주에 하나뿐 ----
    //  여러 명이 동시에 마감을 시도해도 같은 문서에 같은 결과가 들어간다.
    //  한 번 정해진 결과는 고칠 수 없다(수정·삭제 금지).
    match /voteWinners/{weekKey} {
      allow get, list: if true;
      allow create: if weekKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && smallDoc()
        && request.resource.data.keys().hasOnly(['label','count','itemId','decidedAt'])
        && cleanStr(request.resource.data.label, 40)
        && request.resource.data.count is int
        && request.resource.data.count > 0
        && serverTime(request.resource.data.decidedAt);
      allow update, delete: if false;
    }

    // ---- 피드백 게시판: 반 구분 없이 전체 공용, 누구나 읽고 씀 ----
    match /feedback/{id} {
      allow get, list: if true;
      allow create: if smallDoc()
        && request.resource.data.keys().hasOnly(['name','roleTag','message','createdAt'])
        && cleanStr(request.resource.data.name, 40)
        && (request.resource.data.get('roleTag', '') == ''
            || cleanStr(request.resource.data.roleTag, 60))
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 1
        && request.resource.data.message.size() <= 500
        && serverTime(request.resource.data.createdAt);
      allow update: if false;
      // 삭제는 전체 관리자만 노출되는 버튼으로만 호출됨(다른 컬렉션과 동일한 신뢰 모델)
      allow delete: if true;
    }

    // ---- 이스터에그 도감: 이스터에그별 "몇 명이 찾았는지" 카운터만 ----
    //  누가 찾았는지는 저장하지 않는다(개인 식별 정보 없음).
    match /eggStats/{id} {
      // ⚠️ 여기서 실제로 걸렸던 버그:
      //   allow get, list: if id.matches(...) 로 묶어 두면 list(목록 조회)가
      //   항상 거부된다. 컬렉션 전체를 훑는 list 요청에는 {id} 에 들어갈 구체적인
      //   값이 없어서 id.matches(...) 가 성립하지 않기 때문. 그래서 도감의
      //   "지금까지 N명이 발견"이 계속 불러오기에 실패했다.
      //   문서 하나를 콕 집어 읽는 get 에만 ID 형식 검사를 걸고, list 는 허용한다.
      //   (이 컬렉션에는 이스터에그별 발견자 수(count)만 있고 개인정보가 없다)
      allow get: if id.matches('^[a-z0-9]{1,32}$');
      allow list: if true;
      // 새로 만들 땐 1부터, 갱신은 정확히 +1만 — 숫자 조작으로 순위를 부풀릴 수 없음
      allow create: if id.matches('^[a-z0-9]{1,32}$')
        && request.resource.data.keys().hasOnly(['count'])
        && request.resource.data.count == 1;
      allow update: if id.matches('^[a-z0-9]{1,32}$')
        && request.resource.data.keys().hasOnly(['count'])
        && request.resource.data.count == resource.data.count + 1;
      allow delete: if false;
    }

    // ---- 광고 문의 ----
    //  보내는 건 누구나. 열람 버튼은 전체 관리자 화면에만 있지만, 이 스택은
    //  Firebase Auth가 없어 규칙만으로는 "관리자만 읽기"를 강제할 수 없다.
    //  (개별 문서 직접 조회는 막고 목록만 허용 — 문서 ID를 찍어 훔쳐보는 건 차단)
    match /adInquiries/{id} {
      allow get: if false;
      allow list: if true;
      // 이름은 필수다. cleanStr 는 빈 문자열을 통과시키지 않으므로
      // 익명(이름 없는) 광고 문의는 규칙 단에서 저장이 거부된다.
      allow create: if smallDoc()
        && request.resource.data.keys().hasOnly(['name','roleTag','message','createdAt'])
        && cleanStr(request.resource.data.name, 40)
        && nullableStr(request.resource.data.get('roleTag', ''), 60)
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 5
        && request.resource.data.message.size() <= 500
        && serverTime(request.resource.data.createdAt);
      allow update, delete: if false;
    }

    // ---- 그 외 모든 경로 거부 ----
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
